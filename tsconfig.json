{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["api/**/*.ts", "src/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
